#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd lictor >/dev/null; then
        adduser --system --group --no-create-home --home /var/lib/lictor --quiet lictor
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
fi
exit 0
